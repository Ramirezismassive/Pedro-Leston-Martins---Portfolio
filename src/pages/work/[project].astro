
---
import fs from "node:fs";
import path from "node:path";

// Create one page per project and link each page to its previous/next project.
export function getStaticPaths() {
  const projects = {
    sensing: { name: "SENSING", category: "PRODUCT / RESEARCH", folder: "sensing" },
    cherish: { name: "CHERISH", category: "FURNITURE DESIGN", folder: "cherish" },
    "fuji-camera": { name: "FUJI CAMERA", category: "PRODUCT DESIGN", folder: "fuji-camera" },
    evolve: { name: "EVOLVE", category: "PRODUCT", folder: "evolve" },
    dtc: { name: "DTC", category: "PRODUCT", folder: "dtc" },
    push: { name: "PUSH", category: "PRODUCT DESIGN", folder: "push" },
    renders: { name: "RENDERS", category: "3D VISUALISATION", folder: "renders" },
  };

  return Object.entries(projects).map(([project, data], index, entries) => {
    const previous = entries[(index - 1 + entries.length) % entries.length];
    const next = entries[(index + 1) % entries.length];

    return {
      params: { project },
      props: {
        data,
        previous: { slug: previous[0], ...previous[1] },
        next: { slug: next[0], ...next[1] },
      },
    };
  });
}

const { data, previous, next } = Astro.props;

const contentPath = path.join(
  process.cwd(),
  "src",
  "content",
  `${Astro.params.project}.md`
);

let content = "";

if (fs.existsSync(contentPath)) {
  content = fs.readFileSync(contentPath, "utf-8");
}

function getSection(title) {
  const regex = new RegExp(
    `## ${title}\\s*([\\s\\S]*?)(?=\\n## |$)`,
    "i"
  );

  const match = content.match(regex);
  return match ? match[1].trim() : "";
}

function getSectionTitle(text) {
  if (!text) return "";

  const bodyMatch = text.match(/<span class="body">([\s\S]*?)<\/span>/i);

  if (bodyMatch) {
    return text.replace(bodyMatch[0], "").trim();
  }

  return text.trim();
}

function getSectionBody(text) {
  if (!text) return "";

  const bodyMatch = text.match(/<span class="body">([\s\S]*?)<\/span>/i);

  return bodyMatch ? bodyMatch[1].trim() : "";
}

function renderMarkdown(text) {
  if (!text) return "";

  let html = text.trim();

  html = html.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
  html = html.replace(/(?<!\*)\*([^*]+)\*(?!\*)/g, "<em>$1</em>");
  html = html.replace(/\n/g, "<br />");

  return html;
}

const description = getSection("Description");
const projectTitle = getSection("Project Title");

const intro = getSection("Introduction");
const introTitle = getSectionTitle(intro);
const introBody = getSectionBody(intro);

const development = getSection("Development");
const developmentTitle = getSectionTitle(development);
const developmentBody = getSectionBody(development);

const processText = getSection("Process");
const processTitle = getSectionTitle(processText);
const processBody = getSectionBody(processText);

const closing = getSection("Closing");
const closingTitle = getSectionTitle(closing);
const closingBody = getSectionBody(closing);

function getMedia(name) {
  const folder = path.join(
    process.cwd(),
    "public",
    "images",
    data.folder
  );

  const jpg = path.join(folder, `${name}.jpg`);
  const jpeg = path.join(folder, `${name}.jpeg`);
  const png = path.join(folder, `${name}.png`);
  const mp4 = path.join(folder, `${name}.mp4`);

  if (fs.existsSync(mp4)) {
    return { type: "video", src: `/images/${data.folder}/${name}.mp4` };
  }

  if (fs.existsSync(jpg)) {
    return { type: "image", src: `/images/${data.folder}/${name}.jpg` };
  }

  if (fs.existsSync(jpeg)) {
    return { type: "image", src: `/images/${data.folder}/${name}.jpeg` };
  }

  if (fs.existsSync(png)) {
    return { type: "image", src: `/images/${data.folder}/${name}.png` };
  }

  return null;
}

function getNumberedMedia(prefix, variant = "") {
  const media = [];

  for (let i = 1; ; i++) {
    const variantName = variant ? `-${variant}` : "";
    const name = `${prefix}${variantName}-${String(i).padStart(2, "0")}`;
    const item = getMedia(name);

    if (!item) break;

    media.push(item);
  }

  return media;
}

function getMediaGroups(prefix) {
  return [
    { layout: "standard", media: getNumberedMedia(prefix) },
    { layout: "low", media: getNumberedMedia(prefix, "low") },
    { layout: "detail", media: getNumberedMedia(prefix, "detail") },
  ].filter((group) => group.media.length > 0);
}

const hero = getMedia("hero");

const descriptionMedia = getMediaGroups("description");
const introMedia = getMediaGroups("intro");
const developmentMedia = getMediaGroups("development");
const processMedia = getMediaGroups("process");

const finalMedia = getMedia("final");
const finalMediaGroups = getMediaGroups("final");
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{data.name} - Pedro Leston Martins</title>
    <meta
      name="description"
      content={description.replace(/<[^>]*>/g, "")}
    />
  </head>

  <body>
    <main>
      <header>
        <div class="identity">
          <a href="/" class="logo">PEDRO LESTON MARTINS</a>
          <div class="descriptor">
            INDUSTRIAL / PRODUCT / COMPUTATIONAL DESIGN
          </div>
        </div>

        <nav>
          <a href="/work" class="active">WORK</a>
          <a href="/about">ABOUT</a>
          <a href="/contact">CONTACT</a>
        </nav>
      </header>

      <section class="hero">
        {hero && (
          <div
            class:list={[
              "hero-media",
              {
                "hero-video": hero.type === "video",
                "viewport-media": hero.type === "image",
              },
            ]}
          >
            {hero.type === "video" ? (
              <video controls playsinline src={hero.src} />
            ) : (
              <div class="media">
                <img src={hero.src} alt={data.name} />
              </div>
            )}
          </div>
        )}

        <div class="hero-info">
          <h1>{data.name}</h1>
          <span>{data.category}</span>
        </div>

        {description && (
          <div
            class="hero-description"
            set:html={renderMarkdown(description)}
          />
        )}

        {descriptionMedia.map((group) => (
          <div
            class:list={[
              "media-grid",
              `count-${group.media.length}`,
              "series",
              {
                "low-series": group.layout === "low",
                "detail-series": group.layout === "detail",
                "viewport-media": group.media.every(
                  (media) => media.type === "image"
                ),
              },
            ]}
          >
            {group.media.map((media, index) => (
              <div
                class:list={[
                  "media",
                  { "series-first": index === 0 },
                ]}
              >
                {media.type === "video" ? (
                  <video autoplay muted loop playsinline src={media.src} />
                ) : (
                  <img src={media.src} alt={data.name} />
                )}
              </div>
            ))}
          </div>
        ))}
      </section>

      {(projectTitle || intro || introMedia.length > 0) && (
        <section class="section intro">
          {projectTitle && (
            <div
              class="section-title"
              set:html={renderMarkdown(projectTitle)}
            />
          )}

          {introTitle && (
            <div
              class="section-title"
              set:html={renderMarkdown(introTitle)}
            />
          )}

          {introBody && (
            <div class="text" set:html={renderMarkdown(introBody)} />
          )}

          {introMedia.map((group) => (
            <div
              class:list={[
                "media-grid",
                `count-${group.media.length}`,
                "series",
                {
                  "low-series": group.layout === "low",
                  "detail-series": group.layout === "detail",
                  "viewport-media": group.media.every(
                    (media) => media.type === "image"
                  ),
                },
              ]}
            >
              {group.media.map((media, index) => (
                <div
                  class:list={[
                    "media",
                    { "series-first": index === 0 },
                  ]}
                >
                  {media.type === "video" ? (
                    <video autoplay muted loop playsinline src={media.src} />
                  ) : (
                    <img src={media.src} alt={data.name} />
                  )}
                </div>
              ))}
            </div>
          ))}
        </section>
      )}

      {(development || developmentMedia.length > 0) && (
        <section class="section">
          {developmentTitle && (
            <div
              class="section-title"
              set:html={renderMarkdown(developmentTitle)}
            />
          )}

          {developmentBody && (
            <div class="text" set:html={renderMarkdown(developmentBody)} />
          )}

          {developmentMedia.map((group) => (
            <div
              class:list={[
                "media-grid",
                `count-${group.media.length}`,
                "series",
                {
                  "low-series": group.layout === "low",
                  "detail-series": group.layout === "detail",
                  "viewport-media": group.media.every(
                    (media) => media.type === "image"
                  ),
                },
              ]}
            >
              {group.media.map((media, index) => (
                <div
                  class:list={[
                    "media",
                    { "series-first": index === 0 },
                  ]}
                >
                  {media.type === "video" ? (
                    <video autoplay muted loop playsinline src={media.src} />
                  ) : (
                    <img src={media.src} alt={data.name} />
                  )}
                </div>
              ))}
            </div>
          ))}
        </section>
      )}

      {(processText || processMedia.length > 0) && (
        <section class="section">
          {processTitle && (
            <div
              class="section-title"
              set:html={renderMarkdown(processTitle)}
            />
          )}

          {processBody && (
            <div class="text" set:html={renderMarkdown(processBody)} />
          )}

          {processMedia.map((group) => (
            <div
              class:list={[
                "media-grid",
                `count-${group.media.length}`,
                "series",
                {
                  "low-series": group.layout === "low",
                  "detail-series": group.layout === "detail",
                  "viewport-media": group.media.every(
                    (media) => media.type === "image"
                  ),
                },
              ]}
            >
              {group.media.map((media, index) => (
                <div
                  class:list={[
                    "media",
                    { "series-first": index === 0 },
                  ]}
                >
                  {media.type === "video" ? (
                    <video autoplay muted loop playsinline src={media.src} />
                  ) : (
                    <img src={media.src} alt={data.name} />
                  )}
                </div>
              ))}
            </div>
          ))}
        </section>
      )}

      {(closing || finalMedia || finalMediaGroups.length > 0) && (
        <section class="section closing">
          {closingTitle && (
            <div
              class="section-title"
              set:html={renderMarkdown(closingTitle)}
            />
          )}

          {closingBody && (
            <div class="text" set:html={renderMarkdown(closingBody)} />
          )}

          {finalMedia && (
            <div
              class:list={[
                "single-media",
                {
                  "viewport-media": finalMedia.type === "image",
                },
              ]}
            >
              {finalMedia.type === "video" ? (
                <video autoplay muted loop playsinline src={finalMedia.src} />
              ) : (
                <div class="media">
                  <img src={finalMedia.src} alt={data.name} />
                </div>
              )}
            </div>
          )}

          {finalMediaGroups.map((group) => (
            <div
              class:list={[
                "media-grid",
                `count-${group.media.length}`,
                "series",
                {
                  "low-series": group.layout === "low",
                  "detail-series": group.layout === "detail",
                  "viewport-media": group.media.every(
                    (media) => media.type === "image"
                  ),
                },
              ]}
            >
              {group.media.map((media, index) => (
                <div
                  class:list={[
                    "media",
                    { "series-first": index === 0 },
                  ]}
                >
                  {media.type === "video" ? (
                    <video autoplay muted loop playsinline src={media.src} />
                  ) : (
                    <img src={media.src} alt={data.name} />
                  )}
                </div>
              ))}
            </div>
          ))}
        </section>
      )}

      <section class="project-navigation">
        <a href={`/work/${previous.slug}`} class="project-link previous">
          <span class="project-direction">PREVIOUS PROJECT</span>
          <span class="project-name">{previous.name}</span>
        </a>

        <a href={`/work/${next.slug}`} class="project-link next">
          <span class="project-direction">NEXT PROJECT</span>
          <span class="project-name">{next.name}</span>
        </a>
      </section>

      <footer>
        <a href="/work">← WORK</a>
        <span>PEDRO LESTON MARTINS</span>
      </footer>
    </main>

    <div class="corner-navigation">
      <a
        href={`/work/${previous.slug}`}
        class="corner-arrow corner-previous project-link previous"
        aria-label={`Previous project: ${previous.name}`}
      ><span>‹</span></a>

      <a
        href={`/work/${next.slug}`}
        class="corner-arrow corner-next project-link next"
        aria-label={`Next project: ${next.name}`}
      ><span>›</span></a>
    </div>

    <div class="image-lightbox" id="image-lightbox" aria-hidden="true">
      <button
        class="lightbox-close"
        id="lightbox-close"
        type="button"
        aria-label="Close image"
      >×</button>

      <button
        class="lightbox-arrow lightbox-previous"
        id="lightbox-previous"
        type="button"
        aria-label="Previous image"
      >‹</button>

      <img class="lightbox-image" id="lightbox-image" src="" alt="" />

      <button
        class="lightbox-arrow lightbox-next"
        id="lightbox-next"
        type="button"
        aria-label="Next image"
      >›</button>

      <div class="lightbox-counter" id="lightbox-counter"></div>
    </div>
  </body>
</html>

<style>
  :global(:root) {
    --media-max-height: 80vh;
    --image-margin: 32px;
    --image-gap: 32px;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #000;
    color: #fff;
    font-family: Arial, Helvetica, sans-serif;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  header {
    position: relative;
    width: 100%;
    padding: 28px 32px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    z-index: 10;
  }

  .identity {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .logo {
    white-space: nowrap;
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .descriptor {
    margin-top: 28px;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.7);
  }

  nav {
    display: flex;
    gap: 36px;
    font-size: 11px;
    letter-spacing: 0.1em;
  }

  nav a {
    transition: opacity 0.2s ease;
  }

  nav a:hover {
    opacity: 0.5;
  }

  nav .active {
    opacity: 0.45;
  }

  .hero {
    padding: 20px 32px 0;
  }

  .hero-media {
    width: 100%;
    background: #111;
  }

  .hero-media img {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero-video {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    background: #000;
  }

  .hero-video video {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }

  .hero-info {
    margin-top: 28px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .hero-info h1 {
    margin: 0;
    font-size: clamp(45px, 6vw, 90px);
    line-height: 0.85;
    font-weight: 500;
    letter-spacing: -0.07em;
  }

  .hero-info span {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: #777;
  }

  .hero-description {
    width: 66vw;
    max-width: none;
    margin: 45px 0 0;
    font-size: 20px;
    line-height: 1.5;
    letter-spacing: -0.03em;
    color: #bbb;
  }

  :global(.hero-description br:last-child) {
    display: none;
  }

  :global(.red) {
    color: #ff2e0a !important;
  }

  :global(.blue) {
    color: #064477 !important;
  }

  :global(.yellow) {
    color: #fbff00 !important;
  }

  :global(.bold) {
    font-weight: 700 !important;
  }

  :global(.hero-description strong) {
    font-weight: 700;
    color: #fff;
  }

  .section {
    padding: 180px 32px 0;
  }

  .section-title {
    margin: 0 0 45px;
    font-size: clamp(45px, 5vw, 75px);
    line-height: 0.9;
    font-weight: 500;
    letter-spacing: -0.07em;
  }

  :global(.section-title h3),
  :global(.section-title h4) {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
  }

  .text {
    width: 66vw;
    max-width: none;
    font-size: 20px;
    line-height: 1.5;
    color: #bbb;
  }

  :global(.body) {
    font-size: 20px !important;
    line-height: 1.5;
    color: #bbb;
  }

  :global(.text strong) {
    font-weight: 700;
    color: #fff;
  }

  :global(.text em) {
    font-style: italic;
  }

  .single-media {
    width: 100%;
    margin-top: 32px;
  }

  .single-media img,
  .single-media video {
    width: 100%;
    height: auto;
    display: block;
    max-height: var(--media-max-height);
    object-fit: contain;
  }

  .single-media.viewport-media > .media > img {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
  }

  .media-grid {
    width: 100%;
    margin-top: 32px;
    display: flex;
    flex-direction: row;
    gap: var(--image-gap);
    align-items: flex-start;
  }

  .media-grid .media {
    flex: 1 1 0;
    width: 0;
    min-width: 0;
  }

  .media-grid .media img,
  .media-grid .media video {
    display: block;
    width: 100%;
    height: auto;
    max-height: var(--media-max-height);
    object-fit: contain;
  }

  .media-grid.count-1 .media {
    flex: 1 1 100%;
    width: 100%;
    height: auto;
    display: flex;
    justify-content: center;
  }

  .media-grid.count-1 .media img,
  .media-grid.count-1 .media video {
    width: 80%;
    max-width: 80%;
    height: auto;
    max-height: var(--media-max-height);
    object-fit: contain;
  }

  .media-grid.low-series {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
  }

  .media-grid.low-series .media {
    flex: 1 1 0;
    width: 0;
    height: auto;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .media-grid.low-series .media img,
  .media-grid.low-series .media video {
    display: block;
    width: 85%;
    max-width: 85%;
    height: auto;
    max-height: var(--media-max-height);
    object-fit: contain;
  }

  .media-grid.detail-series {
    display: grid;
    grid-template-columns: 2fr 1fr;
    align-items: start;
  }

  .media-grid.detail-series .media {
    width: 100%;
    height: auto;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .media-grid.detail-series .media img,
  .media-grid.detail-series .media video {
    display: block;
    width: 90%;
    max-width: 90%;
    height: auto;
    max-height: var(--media-max-height);
    object-fit: contain;
  }

  /* One shared layout for every image-only media container. */
  .viewport-media {
    position: relative;
    display: block;
    left: calc((100vw - 100%) / -2 + var(--image-margin));
    width: calc(100vw - 2 * var(--image-margin));
    margin-right: 0;
  }

  .viewport-media > .media {
    position: absolute;
    top: 0;
    display: block;
    min-width: 0;
    margin: 0;
    flex: none;
  }

  .viewport-media > .media > img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: contain;
  }

  .media-grid.viewport-media {
    min-height: 0;
  }

  .closing {
    padding-bottom: 160px;
  }

  .project-navigation {
    padding: 0 32px 180px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .project-link {
    display: flex;
    flex-direction: column;
  }

  .project-link.next {
    text-align: right;
    align-items: flex-end;
  }

  .project-direction {
    margin-bottom: 18px;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: #777;
  }

  .project-name {
    font-size: clamp(45px, 5vw, 75px);
    line-height: 0.9;
    font-weight: 500;
    letter-spacing: -0.07em;
    transition: color 0.2s ease;
  }

  .project-link:hover .project-name {
    color: #ff2e0a;
  }

  footer {
    padding: 25px 32px;
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    letter-spacing: 0.08em;
    color: #777;
    border-top: 1px solid #222;
  }

  .corner-navigation {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 100vh;
    z-index: 100;
    pointer-events: none;
  }

  .corner-arrow {
    position: fixed;
    top: 0;
    width: 30px;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ff2e0a;
    color: #000;
    font-size: 32px;
    font-weight: 300;
    line-height: 1;
    opacity: 0;
    transition:
      opacity 0.45s ease,
      transform 0.8s ease;
    pointer-events: none;
  }

  .corner-arrow span {
    display: block;
    width: 1em;
    height: 1em;
    line-height: 1;
    text-align: center;
    transform: translateX(0);
  }

  .corner-previous {
    left: 0;
    transform: translateX(-30px);
  }

  .corner-next {
    right: 0;
    transform: translateX(30px);
  }

  .corner-navigation.show-previous .corner-previous {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  .corner-navigation.show-next .corner-next {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  /* Image lightbox */
  :global(main img) {
    cursor: zoom-in;
  }

  .image-lightbox {
    position: fixed;
    inset: 0;
    z-index: 2000000;
