<script>
  // One sizing and positioning algorithm for every image-only media container.
  function layoutViewportImages() {
    const viewportWidth = document.documentElement.clientWidth;
    const rootStyles = getComputedStyle(document.documentElement);

    const margin =
      parseFloat(rootStyles.getPropertyValue("--image-margin")) || 32;

    const gap =
      parseFloat(rootStyles.getPropertyValue("--image-gap")) || 32;

    const availableWidth = Math.max(1, viewportWidth - margin * 2);
    const maxHeight = Math.max(1, window.innerHeight * 0.8);

    const containers = [
      ...document.querySelectorAll(".viewport-media"),
    ];

    containers.forEach((container) => {
      const images = [
        ...container.querySelectorAll(":scope > .media > img"),
      ];

      if (
        !images.length ||
        images.some(
          (img) =>
            !img.complete ||
            !img.naturalWidth ||
            !img.naturalHeight
        )
      ) {
        return;
      }

      const items = images.map((img) => ({
        img,
        wrapper: img.parentElement,
        ratio: img.naturalWidth / img.naturalHeight,
      }));

      const count = items.length;

      container.style.position = "relative";
      container.style.width = `${availableWidth}px`;
      container.style.left =
        `calc((100vw - 100%) / -2 + ${margin}px)`;
      container.style.display = "block";

      function calculate(height) {
        const widths = items.map((item) =>
          Math.min(availableWidth, item.ratio * height)
        );

        const lefts = [];

        if (count === 1) {
          lefts.push((availableWidth - widths[0]) / 2);
        } else {
          const totalWidth = widths.reduce(
            (sum, width) => sum + width,
            0
          );

          const equalGap =
            (availableWidth - totalWidth) / (count - 1);

          if (equalGap < gap) return null;

          let left = 0;

          for (let i = 0; i < count; i += 1) {
            lefts.push(left);
            left += widths[i] + equalGap;
          }
        }

        const inBounds = lefts.every(
          (left, i) =>
            left >= -0.5 &&
            left + widths[i] <= availableWidth + 0.5
        );

        const noOverlap = lefts.every(
          (left, i) =>
            i === 0 ||
            lefts[i - 1] + widths[i - 1] + gap <= left + 0.5
        );

        return inBounds && noOverlap ? { widths, lefts } : null;
      }

      let low = 0;
      let high = maxHeight;
      let best = calculate(0);

      for (let iteration = 0; iteration < 40; iteration += 1) {
        const mid = (low + high) / 2;
        const result = calculate(mid);

        if (result) {
          best = result;
          low = mid;
        } else {
          high = mid;
        }
      }

      if (!best) {
        best = {
          widths: items.map(() => 1),
          lefts: items.map(() => 0),
        };
      }

      let rowHeight = 0;

      items.forEach((item, index) => {
        const width = best.widths[index];
        const height = width / item.ratio;
        const wrapper = item.wrapper;
        const img = item.img;

        wrapper.style.position = "absolute";
        wrapper.style.left = `${best.lefts[index]}px`;
        wrapper.style.top = "0";
        wrapper.style.width = `${width}px`;
        wrapper.style.height = `${height}px`;
        wrapper.style.margin = "0";
        wrapper.style.flex = "none";

        img.style.display = "block";
        img.style.objectFit = "contain";
        img.style.maxWidth = "none";
        img.style.maxHeight = "none";
        img.style.width = "100%";
        img.style.height = "100%";

        rowHeight = Math.max(rowHeight, height);
      });

      container.style.height = `${rowHeight}px`;
    });
  }

  function setHeroVideoHeight() {
    const video = document.querySelector(".hero-video video");

    if (!video) return;

    const top = video.getBoundingClientRect().top;
    const availableHeight = window.innerHeight - top;

    if (availableHeight > 0) {
      video.style.maxHeight = `${availableHeight}px`;
    }
  }

  function autoplayHeroVideo() {
    const video = document.querySelector(".hero-video video");

    if (!video) return;

    video.muted = false;
    video.volume = 1;

    if (window.parent !== window) return;

    setTimeout(() => {
      video.play().catch(() => {});
    }, 1000);
  }

  function updateLayouts() {
    setHeroVideoHeight();
    requestAnimationFrame(layoutViewportImages);
  }

  window.addEventListener("load", () => {
    setHeroVideoHeight();
    autoplayHeroVideo();
    requestAnimationFrame(layoutViewportImages);
  });

  window.addEventListener("resize", updateLayouts);

  document
    .querySelectorAll(".viewport-media img")
    .forEach((image) => {
      image.addEventListener("load", () => {
        requestAnimationFrame(layoutViewportImages);
      });
    });

  document.querySelectorAll(".media-grid video").forEach((video) => {
    video.addEventListener("loadedmetadata", updateLayouts);
  });
</script>

<script>
  const cornerNavigation =
    document.querySelector(".corner-navigation");

  if (cornerNavigation) {
    const edgeSize = 30;

    window.addEventListener("mousemove", (event) => {
      const showPrevious = event.clientX <= edgeSize;
      const showNext = event.clientX >= window.innerWidth - edgeSize;

      cornerNavigation.classList.toggle(
        "show-previous",
        showPrevious
      );

      cornerNavigation.classList.toggle(
        "show-next",
        showNext
      );
    });
  }
</script>

<script>
  const projectTransitionSpeed = 100;

  document.querySelectorAll(".project-link").forEach((link) => {
    link.addEventListener("click", async (event) => {
      if (
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        event.button !== 0
      ) {
        return;
      }

      event.preventDefault();

      const destination = link.href;
      const isPrevious = link.classList.contains("previous");

      const iframe = document.createElement("iframe");

      iframe.style.position = "fixed";
      iframe.style.inset = "0";
      iframe.style.width = "100vw";
      iframe.style.height = "100vh";
      iframe.style.border = "0";
      iframe.style.zIndex = "999999";
      iframe.style.pointerEvents = "none";
      iframe.style.opacity = "0";
      iframe.style.background = "#000";

      document.body.appendChild(iframe);
      iframe.src = destination;

      await new Promise((resolve) => {
        iframe.addEventListener("load", resolve, { once: true });
      });

      try {
        const images = Array.from(
          iframe.contentDocument?.images || []
        );

        images.forEach((image) => {
          image.loading = "eager";
          image.setAttribute("loading", "eager");
        });

        await Promise.all(
          images.map((image) => {
            if (!image.complete) {
              return new Promise((resolve) => {
                image.addEventListener("load", resolve, { once: true });
                image.addEventListener("error", resolve, { once: true });
              });
            }

            return Promise.resolve();
          })
        );

        await Promise.all(
          images.map(async (image) => {
            if (typeof image.decode === "function") {
              try {
                await image.decode();
              } catch {
                // Ignore individual image decode failures.
              }
            }
          })
        );

        await new Promise((resolve) => {
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              requestAnimationFrame(resolve);
            });
          });
        });
      } catch {
        // Continue if image inspection is unavailable.
      }

      const svgNS = "http://www.w3.org/2000/svg";
      const svg = document.createElementNS(svgNS, "svg");

      svg.setAttribute("width", "100%");
      svg.setAttribute("height", "100%");
      svg.setAttribute("viewBox", "0 0 2000 1200");
      svg.setAttribute("preserveAspectRatio", "none");

      svg.style.position = "fixed";
      svg.style.inset = "0";
      svg.style.width = "100vw";
      svg.style.height = "100vh";
      svg.style.pointerEvents = "none";
      svg.style.zIndex = "1000000";

      const defs = document.createElementNS(svgNS, "defs");
      const mask = document.createElementNS(svgNS, "mask");
      const maskId = `project-transition-mask-${Date.now()}`;

      mask.setAttribute("id", maskId);
      mask.setAttribute("maskUnits", "userSpaceOnUse");
      mask.setAttribute("x", "0");
      mask.setAttribute("y", "0");
      mask.setAttribute("width", "2000");
      mask.setAttribute("height", "1200");

      const background = document.createElementNS(svgNS, "rect");

      background.setAttribute("x", "0");
      background.setAttribute("y", "0");
      background.setAttribute("width", "2000");
      background.setAttribute("height", "1200");
      background.setAttribute("fill", "black");

      mask.appendChild(background);

      const columns = 20;
      const rows = 12;
      const cellWidth = 2000 / columns;
      const cellHeight = 1200 / rows;
      const rowCells = [];

      for (let y = 0; y < rows; y++) {
        const cells = [];

        for (let x = 0; x < columns; x++) {
          const rect = document.createElementNS(svgNS, "rect");

          rect.setAttribute("x", x * cellWidth);
          rect.setAttribute("y", y * cellHeight);
          rect.setAttribute("width", cellWidth + 1);
          rect.setAttribute("height", cellHeight + 1);
          rect.setAttribute("fill", "white");
          rect.style.opacity = "0";

          mask.appendChild(rect);
          cells.push(rect);
        }

        rowCells.push(isPrevious ? cells.reverse() : cells);
      }

      defs.appendChild(mask);
      svg.appendChild(defs);
      document.body.appendChild(svg);

      iframe.style.maskImage = `url(#${maskId})`;
      iframe.style.webkitMaskImage = `url(#${maskId})`;
      iframe.style.opacity = "1";

      await new Promise((resolve) => {
        requestAnimationFrame(() => {
          requestAnimationFrame(resolve);
        });
      });

      const rowSpeeds = Array.from(
        { length: rows },
        () => projectTransitionSpeed * (0.5 + Math.random() * 1.3)
      );

      let completedRows = 0;

      rowCells.forEach((cells, rowIndex) => {
        const speed = rowSpeeds[rowIndex];
        let current = 0;
        const startTime = performance.now();

        function revealRow(now) {
          const elapsed = now - startTime;

          const target = Math.min(
            Math.floor(elapsed / speed),
            cells.length
          );

          while (current < target) {
            cells[current].style.opacity = "1";
            current++;
          }

          if (current < cells.length) {
            requestAnimationFrame(revealRow);
            return;
          }

          completedRows++;

          if (completedRows === rows) {
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                window.location.href = destination;
              });
            });
          }
        }

        requestAnimationFrame(revealRow);
      });
    });
  });
</script>

<script>
  // Image lightbox with previous/next navigation.
  const lightbox = document.getElementById("image-lightbox");
  const lightboxImage = document.getElementById("lightbox-image");
  const lightboxCounter = document.getElementById("lightbox-counter");
  const lightboxClose = document.getElementById("lightbox-close");
  const lightboxPrevious = document.getElementById("lightbox-previous");
  const lightboxNext = document.getElementById("lightbox-next");

  let lightboxImages = [];
  let lightboxIndex = 0;

  function getLightboxImages() {
    return Array.from(document.querySelectorAll("main img")).filter(
      (image) =>
        image.complete &&
        image.naturalWidth > 0 &&
        !image.closest(".image-lightbox")
    );
  }

  function showLightboxImage(index) {
    if (!lightboxImages.length) return;

    lightboxIndex =
      (index + lightboxImages.length) % lightboxImages.length;

    const selectedImage = lightboxImages[lightboxIndex];

    lightboxImage.src = selectedImage.currentSrc || selectedImage.src;
    lightboxImage.alt = selectedImage.alt || "";
    lightboxCounter.textContent =
      `${lightboxIndex + 1} / ${lightboxImages.length}`;

    const showArrows = lightboxImages.length > 1;

    lightboxPrevious.style.display = showArrows ? "flex" : "none";
    lightboxNext.style.display = showArrows ? "flex" : "none";
  }

  function openLightbox(image) {
    lightboxImages = getLightboxImages();
    lightboxIndex = lightboxImages.indexOf(image);

    if (lightboxIndex < 0) return;

    showLightboxImage(lightboxIndex);
    lightbox.classList.add("is-open");
    lightbox.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    lightbox.classList.remove("is-open");
    lightbox.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    lightboxImage.src = "";
  }

  document.querySelectorAll("main img").forEach((image) => {
    image.addEventListener("click", () => openLightbox(image));
  });

  lightboxClose.addEventListener("click", closeLightbox);

  lightboxPrevious.addEventListener("click", (event) => {
    event.stopPropagation();
    showLightboxImage(lightboxIndex - 1);
  });

  lightboxNext.addEventListener("click", (event) => {
    event.stopPropagation();
    showLightboxImage(lightboxIndex + 1);
  });

  lightbox.addEventListener("click", (event) => {
    if (event.target === lightbox) {
      closeLightbox();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (!lightbox.classList.contains("is-open")) return;

    if (event.key === "Escape") {
      closeLightbox();
    } else if (event.key === "ArrowLeft") {
      showLightboxImage(lightboxIndex - 1);
    } else if (event.key === "ArrowRight") {
      showLightboxImage(lightboxIndex + 1);
    }
  });
</script>

