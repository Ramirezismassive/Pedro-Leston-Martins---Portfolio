---
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>About — Pedro Leston Martins</title>

    <meta
      name="description"
      content="About Pedro Leston Martins, an Industrial, Product and Computational Designer."
    />
  </head>

  <body>

    <main>

      <!-- HEADER -->

      <header>

        <div class="identity">

          <a href="/" class="logo">
            PEDRO LESTON MARTINS
          </a>

          <div class="descriptor">
            INDUSTRIAL / PRODUCT / COMPUTATIONAL DESIGN
          </div>

        </div>


        <nav>
          <a href="/work">WORK</a>
          <a href="/about" class="active">ABOUT</a>
          <a href="/contact">CONTACT</a>
        </nav>

      </header>


      <!-- ABOUT -->

      <section class="about">

        <div class="about-title">
          ABOUT
        </div>


        <div class="intro">

          <h1>
            Industrial designer with experience across
            product development, CAD, computational
            design, visualisation and physical
            prototyping.
          </h1>

        </div>


        <!-- PROFILE -->

        <div class="details">

          <div class="column profile-text">

            <p>
              My practice combines creative problem solving
              with technical development, moving between
              concept development, digital modelling,
              engineering and physical making.
            </p>

            <p>
              I work across both independent design projects
              and technical environments, developing products,
              furniture, systems and spatial solutions from
              early concepts through to production.
            </p>

          </div>


          <div class="column">

            <div class="small-label">
              DISCIPLINES
            </div>

            <ul>
              <li>Industrial Design</li>
              <li>Product Design</li>
              <li>Computational Design</li>
              <li>CAD & Engineering</li>
              <li>3D Visualisation</li>
              <li>Prototyping & Making</li>
            </ul>

          </div>

        </div>


        <!-- IMAGE -->

        <div class="about-image">

          <img
            src="/images/about.jpg"
            alt="Pedro Leston Martins design work"
          />

        </div>


        <!-- EXPERIENCE -->

        <div class="experience">

          <div class="small-label">
            EXPERIENCE
          </div>


          <div class="experience-list">

            <div class="experience-item">

              <div class="year">
                CURRENT
              </div>

              <div>

                <h2>
                  Design & Technical Support Coordinator
                </h2>

                <p>
                  UNIPAC
                </p>

              </div>

            </div>


            <div class="experience-item">

              <div class="year">
                2023 — PRESENT
              </div>

              <div>

                <h2>
                  Research & Design Assistant
                </h2>

                <p>
                  Victoria University of Wellington
                </p>

              </div>

            </div>


            <div class="experience-item">

              <div class="year">
                2024
              </div>

              <div>

                <h2>
                  Academic Tutor
                </h2>

                <p>
                  Faculty of Architecture
                  and Design Innovation
                </p>

              </div>

            </div>

          </div>

        </div>


        <!-- EDUCATION + AWARDS -->

        <div class="education-awards">

          <!-- EDUCATION -->

          <div class="education">

            <div class="small-label">
              EDUCATION
            </div>

            <h2>
              Bachelor of Design
            </h2>

            <p>
              Design Innovation · Industrial Design
            </p>

            <p>
              Victoria University of Wellington
            </p>

          </div>


          <!-- AWARDS -->

          <div class="awards">

            <div class="small-label">
              AWARDS
            </div>


            <div class="awards-list">

              <div class="award-item">

                <div class="award-year">
                  2023
                </div>

                <div>

                  <h2>
                    Excellence Award for Industrial Design
                  </h2>

                  <p>
                    Faculty of Architecture and
                    Design Innovation · Victoria University
                    of Wellington
                  </p>

                </div>

              </div>


              <div class="award-item">

                <div class="award-year">
                  2023
                </div>

                <div>

                  <h2>
                    Dean's List for Design Innovation
                  </h2>

                  <p>
                    Victoria University of Wellington
                  </p>

                </div>

              </div>


              <div class="award-item">

                <div class="award-year">
                  2022
                </div>

                <div>

                  <h2>
                    Dean's List for Design Innovation
                  </h2>

                  <p>
                    Victoria University of Wellington
                  </p>

                </div>

              </div>

            </div>

          </div>

        </div>

      </section>


      <!-- FOOTER -->

      <footer>

        <span>
          © {new Date().getFullYear()}
        </span>

        <span>
          PEDRO LESTON MARTINS
        </span>

      </footer>

    </main>

  </body>
</html>


<style>

  :global(*) {
    box-sizing: border-box;
  }


  :global(html) {
    scroll-behavior: smooth;
  }


  :global(body) {
    margin: 0;

    background: #000;

    color: #fff;

    font-family:
      Arial,
      Helvetica,
      sans-serif;
  }


  a {
    color: inherit;

    text-decoration: none;
  }


  /* HEADER */

  header {

    position: relative;

    width: 100%;

    padding: 28px 32px;

    display: flex;

    justify-content: space-between;

    align-items: flex-start;

    z-index: 10;
  }


  .identity {

    display: flex;

    flex-direction: column;

    align-items: flex-start;
  }


  .logo {

    white-space: nowrap;

    font-size: 32px;

    font-weight: 700;

    letter-spacing: -0.05em;

    line-height: 1;
  }


  .descriptor {

    margin-top: 28px;

    font-size: 11px;

    letter-spacing: 0.1em;

    color: rgba(255, 255, 255, 0.7);
  }


  /* NAVIGATION */

  nav {

    display: flex;

    gap: 36px;

    font-size: 11px;

    letter-spacing: 0.1em;
  }


  nav a {

    transition: opacity 0.2s ease;
  }


  nav a:hover {

    opacity: 0.5;
  }


  nav .active {

    opacity: 0.45;
  }


  /* ABOUT */

  .about {

    position: relative;

    padding: 20px 32px 160px;
  }


  .about-title {

    margin-top: 80px;

    font-size: clamp(55px, 6vw, 95px);

    line-height: 0.8;

    letter-spacing: -0.08em;

    font-weight: 500;
  }


  /* INTRO */

  .intro {

    margin-top: 45px;

    max-width: 975px;
  }


  .intro h1 {

    margin: 0;

    font-size: clamp(33px, 3vw, 45px);

    line-height: 1.05;

    letter-spacing: -0.04em;

    font-weight: 500;
  }


  /* DETAILS */

  .details {

    margin-top: 70px;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 12vw;

    max-width: 1100px;

    align-items: end;
  }


  .column {

    max-width: 520px;
  }


  .profile-text {

    padding-top: 30px;

    padding-bottom: 0;
  }


  .column p {

    margin: 0 0 28px;

    font-size: 20px;

    line-height: 1.5;

    color: #bbb;
  }


  .small-label {

    margin-bottom: 25px;

    font-size: 14px;

    letter-spacing: 0.1em;

    color: #777;
  }


  /* DISCIPLINES */

  ul {

    list-style: none;

    padding: 0;

    margin: 0;
  }


  li {

    padding: 12px 0;

    border-bottom: 1px solid #333;

    font-size: 17px;

    color: #aaa;
  }


  /* IMAGE */

  .about-image {

    position: absolute;

    top: 160px;

    right: 32px;

    width: 27vw;

    max-width: 450px;

    height: 65vh;

    overflow: hidden;

    z-index: 0;
  }


  .about-image img {

    width: 100%;

    height: 100%;

    object-fit: cover;

    display: block;
  }


  /* EXPERIENCE */

  .experience {

    margin-top: 180px;
  }


  .experience-list {

    max-width: 1100px;

    border-top: 1px solid #333;
  }


  .experience-item {

    display: grid;

    grid-template-columns: 180px 1fr;

    gap: 40px;

    padding: 28px 0;

    border-bottom: 1px solid #333;
  }


  .year {

    font-size: 14px;

    letter-spacing: 0.08em;

    color: #777;
  }


  .experience-item h2 {

    margin: 0 0 8px;

    font-size: 25px;

    font-weight: 500;

    letter-spacing: -0.03em;
  }


  .experience-item p {

    margin: 0;

    color: #777;

    font-size: 17px;
  }


  /* EDUCATION + AWARDS */

  .education-awards {

    margin-top: 160px;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 12vw;

    max-width: 1100px;
  }


  /* EDUCATION */

  .education {

    margin-top: 0;

    max-width: 600px;
  }


  .education h2 {

    margin: 0 0 8px;

    font-size: 40px;

    font-weight: 500;

    letter-spacing: -0.04em;
  }


  .education p {

    margin: 0 0 8px;

    color: #777;

    font-size: 17px;
  }


  /* AWARDS */

  .awards {

    margin-top: 0;

    max-width: 800px;
  }


  .awards .small-label {

    margin-bottom: 18px;

    font-size: 13px;

    color: #555;
  }


  .awards-list {

    border-top: 1px solid #222;
  }


  .award-item {

    display: grid;

    grid-template-columns: 100px 1fr;

    gap: 25px;

    padding: 16px 0;

    border-bottom: 1px solid #222;
  }


  .award-year {

    font-size: 13px;

    letter-spacing: 0.08em;

    color: #555;
  }


  .award-item h2 {

    margin: 0 0 5px;

    font-size: 17px;

    font-weight: 400;

    letter-spacing: -0.01em;

    color: #aaa;
  }


  .award-item p {

    margin: 0;

    color: #555;

    font-size: 14px;

    line-height: 1.4;
  }


  /* FOOTER */

  footer {

    padding: 25px 32px;

    border-top: 1px solid #222;

    display: flex;

    justify-content: space-between;

    font-size: 14px;

    letter-spacing: 0.08em;

    color: #777;
  }


  /* MOBILE */

  @media (max-width: 700px) {

    header {

      padding: 22px;
    }


    .logo {

      font-size: 20px;
    }


    nav {

      gap: 14px;

      font-size: 9px;
    }


    .about {

      padding: 60px 22px 100px;
    }


    .about-title {

      margin-top: 75px;

      font-size: 12vw;
    }


    .descriptor {

      margin-top: 18px;

      font-size: 9px;

      color: rgba(255, 255, 255, 0.7);
    }


    .intro {

      margin-top: 55px;

      max-width: 100%;
    }


    .intro h1 {

      font-size: 6vw;
    }


    .details {

      margin-top: 100px;

      grid-template-columns: 1fr;

      gap: 80px;

      max-width: 100%;

      align-items: initial;
    }


    .profile-text {

      padding-top: 0;
    }


    .about-image {

      position: relative;

      top: auto;

      right: auto;

      width: 100%;

      max-width: none;

      height: 60vh;

      margin-top: 80px;
    }


    .experience {

      margin-top: 110px;
    }


    .experience-item {

      grid-template-columns: 1fr;

      gap: 12px;
    }


    .education-awards {

      margin-top: 100px;

      grid-template-columns: 1fr;

      gap: 80px;
    }


    .awards {

      margin-top: 0;
    }


    .award-item {

      grid-template-columns: 70px 1fr;

      gap: 15px;
    }


    footer {

      padding: 20px 22px;
    }

  }

</style>

<script src="../scripts/page-transition.js"></script>

<script>
  import "../scripts/cursor-glow.js";
</script>