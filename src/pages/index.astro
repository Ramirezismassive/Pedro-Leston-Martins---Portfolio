```astro id="q7n5wx"
---
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Pedro Leston Martins</title>

    <meta
      name="description"
      content="Pedro Leston Martins — Industrial, Product and Computational Designer."
    />
  </head>

  <body>
    <main class="landing">
      <div class="background-image"></div>

      <div class="overlay"></div>

      <header>
        <div class="identity">
          <a href="/" class="logo">
            PEDRO LESTON MARTINS
          </a>

          <div class="descriptor">
            INDUSTRIAL / PRODUCT / COMPUTATIONAL DESIGN
          </div>
        </div>

        <nav>
          <a href="/work">WORK</a>
          <a href="/about">ABOUT</a>
          <a href="/contact">CONTACT</a>
        </nav>
      </header>

      <section class="content">
        <div class="hero">
          <h1>
            Design through exploration.<br />
            Systems with purpose.<br />
            Practical outcomes.
          </h1>
        </div>
      </section>

      <footer>
        <span>© {new Date().getFullYear()}</span>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  :global(body) {
    font-family:
      Arial,
      Helvetica,
      sans-serif;
    color: white;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .landing {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background: #000;
  }

  .background-image {
    position: absolute;
    inset: 0;
    background-image: url("/images/hero.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: 0;
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.25);
    z-index: 1;
    pointer-events: none;
  }

  header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    padding: 28px 32px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    z-index: 10;
  }

  .identity {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .logo {
    white-space: nowrap;
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .descriptor {
    margin-top: 28px;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.7);
  }

  nav {
    display: flex;
    gap: 36px;
    font-size: 11px;
    letter-spacing: 0.1em;
  }

  nav a {
    transition: opacity 0.2s ease;
  }

  nav a:hover {
    opacity: 0.5;
  }

  .content {
    position: relative;
    z-index: 5;
    height: 100%;
    padding: 125px 32px 35px;
  }

  .hero {
    margin-top: 8vh;
  }

  h1 {
    max-width: 1200px;
    margin: 0;
    font-size: clamp(60px, 8vw, 135px);
    line-height: 0.88;
    letter-spacing: -0.07em;
    font-weight: 500;
  }

  footer {
    position: absolute;
    right: 32px;
    bottom: 0;
    z-index: 10;
    padding-bottom: 25px;
    font-size: 14px;
    line-height: 1;
    letter-spacing: 0.08em;
    color: #777;
  }

  @media (max-width: 700px) {
    header {
      padding: 22px;
    }

    .logo {
      font-size: 20px;
    }

    .descriptor {
      margin-top: 18px;
      font-size: 9px;
    }

    nav {
      gap: 14px;
      font-size: 9px;
    }

    .content {
      height: 100%;
      padding: 110px 22px 60px;
    }

    .hero {
      margin-top: 8vh;
    }

    h1 {
      font-size: 13vw;
    }

    footer {
      right: 22px;
      bottom: 0;
      padding-bottom: 18px;
      font-size: 14px;
      line-height: 1;
      letter-spacing: 0.08em;
      color: #777;
    }
  }
</style>

<script src="../scripts/page-transition.js"></script>
<script>
  import "../scripts/cursor-glow.js";
</script>
